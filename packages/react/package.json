{
  "name": "@artisanpack-ui/react",
  "version": "2.0.0",
  "description": "React components for the ArtisanPack UI design system, styled by @artisanpack-ui/css",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./form": {
      "import": "./dist/form.mjs",
      "types": "./dist/form.d.ts"
    },
    "./layout": {
      "import": "./dist/layout.mjs",
      "types": "./dist/layout.d.ts"
    },
    "./navigation": {
      "import": "./dist/navigation.mjs",
      "types": "./dist/navigation.d.ts"
    },
    "./data": {
      "import": "./dist/data.mjs",
      "types": "./dist/data.d.ts"
    },
    "./chart": {
      "import": "./dist/chart.mjs",
      "types": "./dist/chart.d.ts"
    },
    "./feedback": {
      "import": "./dist/feedback.mjs",
      "types": "./dist/feedback.d.ts"
    },
    "./utility": {
      "import": "./dist/utility.mjs",
      "types": "./dist/utility.d.ts"
    },
    "./ai": {
      "import": "./dist/ai.mjs",
      "types": "./dist/ai.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@artisanpack-ui/behavior": "^1.0.0",
    "@zag-js/react": "~1.47.0"
  },
  "devDependencies": {
    "@artisanpack-ui/css": "^1.0.0",
    "@artisanpack-ui/manifest": "^1.0.0",
    "@artisanpack-ui/testing": "^1.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {},
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
